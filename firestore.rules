rules_version = '2';

// ATM10 Codex — Firestore security rules.
//
// Source of truth for the rules. Deploy by pasting into the Firebase console
// (Firestore Database → Rules). Mirrors the app's capabilities.js predicate-for-predicate:
//   - super-admin = one of the baked email literals (matches appConfig.auth.adminEmail)
//   - everyone else's access comes from their per-codex permissions/{uid}_{codexId} doc
//   - editor writes codex content; viewer reads only; schemas are admin-only (Types is admin work)
//   - the shared `images` library gates on membership: editors touch their codex + own labels,
//     everything global is admin (see the images block for the full framing)
//
// Parity with the app mirror is guarded by src/utils/capabilities.parity.test.js: it asserts the
// admin-email allowlist below matches appConfig.auth.adminEmail and that every role literal here is
// one capabilities.js recognizes. Edit an authorization predicate → update capabilities.js too.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in ['bodegigaming@gmail.com', 'aspensquare.chuck@gmail.com'];
    }
    function permId(codexId) {
      return request.auth.uid + '_' + codexId;
    }
    function hasPerm(codexId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/permissions/$(permId(codexId)));
    }
    function isEditor(codexId) {
      return hasPerm(codexId)
        && get(/databases/$(database)/documents/permissions/$(permId(codexId))).data.role == 'editor';
    }
    // A codex you may write content into: admin everywhere, or an editor of that specific codex.
    function canEdit(codexId) {
      return isAdmin() || isEditor(codexId);
    }
    // Private-site invite gate. A live invite is active AND (no expiry OR now before expiresAt).
    // `expiresAt` is epoch millis (or null). get()/exists() bypass the invites block's admin-only
    // allow rules, so a would-be new user is validated against an invite they can't themselves read.
    // Pure mirror: src/schema/inviteModel.isInviteRedeemable — change both together.
    function inviteRedeemable(token) {
      // exists() FIRST so a missing invite short-circuits before any .data dereference (get() on a
      // non-existent path is not safe to read). get() results are cached within one rule evaluation.
      return exists(/databases/$(database)/documents/invites/$(token))
        && get(/databases/$(database)/documents/invites/$(token)).data.status == 'active'
        && (get(/databases/$(database)/documents/invites/$(token)).data.expiresAt == null
            || request.time.toMillis() < get(/databases/$(database)/documents/invites/$(token)).data.expiresAt);
    }

    // Invite tokens (doc id == the secret UUID). `get` is allowed for any signed-in user: knowing the
    // exact token IS the authorization (capability-URL style), and it lets the client validate + show
    // the right screen before attempting the users-create write. `list` (enumeration) and all writes are
    // admin-only. The users-create rule below still independently enforces redeemability via get()/exists().
    match /invites/{token} {
      allow get:          if isSignedIn();
      allow list, write:  if isAdmin();
    }

    // Global identity roster. Split so a NEW row (create) requires a live invite the admin issued —
    // this is what stops random Google sign-ins from accruing junk rows. Returning users only refresh
    // lastSeenAt (update) and can't rewrite their write-once `invitedVia` provenance. See invite-access spec.
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.invitedVia is string
            && inviteRedeemable(request.resource.data.invitedVia));
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.get('invitedVia', null) == resource.data.get('invitedVia', null));
    }

    // Access grants. Read keyed by id-prefix (NOT resource.data) so a *missing* own-permission doc
    // reads as empty rather than denied — an awaiting-access user must be able to learn they have none.
    // A user may LIST their own grants (query where uid == me) to discover which codices they can open.
    // Writes are admin-only: nobody grants themselves access.
    // `get`'s `doc.split('_')[0] == uid` is an exact owner-check ONLY because Firebase Auth uids contain
    // no '_', so the uid is precisely the first segment of the `{uid}_{codexId}` id (built by permId).
    // Keep that id shape: a uid containing '_', or reordering to `{codexId}_{uid}`, would mismatch (deny a
    // user their own grant → stuck awaiting-access) or let a uid-prefix collision read someone else's doc.
    match /permissions/{doc} {
      allow get:   if isAdmin() || (isSignedIn() && doc.split('_')[0] == request.auth.uid);
      allow list:  if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Codices + their content.
    match /codices/{codexId} {
      allow get:   if isAdmin() || hasPerm(codexId);
      allow list:  if isAdmin();                                  // only an admin enumerates all codices
      allow write: if isAdmin();                                  // codex metadata: admin only

      // Entries carry a monotonic integer `version`. The app writes under a transaction that reads the
      // live version and writes version+1 (a full-doc replace, so field deletions persist); this rule is
      // the data-layer backstop that no write skips or rolls back the version. Conflict *detection* is
      // client-side (only the client knows the base version it started from) — see the write-path spec.
      match /entries/{entryId} {
        function canWriteEntry() { return isAdmin() || isEditor(codexId); }
        allow read:   if isAdmin() || hasPerm(codexId);
        allow create: if canWriteEntry()
          && request.resource.data.version is int
          && request.resource.data.version == 1;
        allow update: if canWriteEntry()
          && request.resource.data.version is int
          && request.resource.data.version == (('version' in resource.data ? resource.data.version : 0) + 1);
        // Soft-delete is the archive `status` flag (an editor `update`, restorable). A real document
        // delete is an admin break-glass beside it (CodexScope.deleteEntry) — permanent, no restore —
        // so hard delete is admin-only. Mirrors capabilities.canAdmin on the UI side.
        allow delete: if isAdmin();

        // Per-entry recovery ring. Each save copies the version it writes here (doc id == that
        // version), atomic with the live write, so a bad "overwrite mine" — or an out-of-band
        // corruption of the live doc — is recoverable; pruning keeps the last N
        // (src/schema/entryHistory.js). Each version is written once, so create suffices — snapshots
        // are immutable (no update). Same read/write gate as the entry: viewers browse, editors write
        // (the save txn) and prune.
        match /history/{version} {
          allow read:          if isAdmin() || hasPerm(codexId);
          allow create, delete: if canWriteEntry();
        }
      }
      match /schemas/{type} {
        allow read:  if isAdmin() || hasPerm(codexId);
        allow write: if isAdmin();                                // Types editing is admin-only

        // Per-type structure-history ring (issue #54), the schema analogue of the entry ring above.
        // Each save copies the schema version it writes here (doc id == that version), atomic with the
        // live write; snapshots are immutable (create only). Read follows schema read; write/prune is
        // admin, matching Types editing.
        match /history/{version} {
          allow read:           if isAdmin() || hasPerm(codexId);
          allow create, delete: if isAdmin();
        }
      }
    }

    // Shared image library. Bytes live in Supabase (gated by Storage RLS); this collection is the
    // metadata source of truth for what exists and where it belongs. Framing that keeps the rules
    // enforceable: editors only ever touch codex membership and their own uploads' label —
    // everything global (status, cross-assigning to a codex you can't edit, relabeling others'
    // images) is admin. `id` == content hash == doc id == Supabase object key.
    match /images/{imageId} {
      // Keys changed by this write (added / removed / value-changed). updatedAt is always present.
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // Codices in the new membership but not the old (and vice-versa). List difference, not a loop:
      // membership changes one codex at a time, so exactly one of these is size 1 and the other 0.
      function addedCodices() {
        return request.resource.data.codices.removeAll(resource.data.codices);
      }
      function removedCodices() {
        return resource.data.codices.removeAll(request.resource.data.codices);
      }
      // Editor path (a): add or remove a single codex you can edit, nothing else but the timestamp.
      function editorMembershipChange() {
        return changedKeys().hasOnly(['codices', 'updatedAt'])
          && (
            (addedCodices().size() == 1 && removedCodices().size() == 0 && canEdit(addedCodices()[0]))
            || (removedCodices().size() == 1 && addedCodices().size() == 0 && canEdit(removedCodices()[0]))
          );
      }
      // Editor path (b): rename your own upload. Relabeling someone else's image is admin-only.
      function uploaderRelabel() {
        return changedKeys().hasOnly(['label', 'updatedAt'])
          && resource.data.uploadedBy == request.auth.uid;
      }

      // Metadata isn't secret and the app already gates on sign-in.
      allow read: if isSignedIn();

      // Upload: editor of the single target codex (or admin). Uploader stamps self; new records active.
      allow create: if isSignedIn()
        && request.resource.data.id == imageId
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.codices.size() == 1
        && canEdit(request.resource.data.codices[0]);

      // Admin does anything (status archive/restore, cross-assign, relabel others); editors get the
      // two narrow paths above. Note: an editor re-uploading an *archived* image hits the resurrect
      // (status) write, which is admin-only here — that upload is denied by design.
      allow update: if isAdmin() || editorMembershipChange() || uploaderRelabel();

      // Soft-delete is a status flag, not a document delete. Hard delete is an admin break-glass.
      allow delete: if isAdmin();
    }

    // App-global icon overlay. SVG-as-text records concatenated onto the bundled baseline
    // (iconRegistry.mergeIcons) so a type's `icon` key can resolve to an admin-added glyph. Any
    // signed-in user reads it (the nav renders icons); curation is admin-only. Soft-delete via a
    // `status` flag mirrors images/entries — an archived icon just drops from the overlay. The doc
    // id is the icon key.
    match /icons/{key} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // App-global emblem set. Sibling of `icons` (icon-designer.md §2): full-color glyphs authored in
    // the in-app designer, keyed by emblem key (the doc id). No bundled baseline — the app renders
    // straight from this collection. Same read/write story as icons: any signed-in user reads (content
    // + map markers render emblems), curation is admin-only, soft-delete via a `status` flag.
    match /emblems/{key} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
