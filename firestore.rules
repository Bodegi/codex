rules_version = '2';

// ATM10 Codex — Firestore security rules.
//
// Source of truth for the rules. Deploy by pasting into the Firebase console
// (Firestore Database → Rules). Mirrors the app's capabilities.js predicate-for-predicate:
//   - super-admin = one of the baked email literals (matches appConfig.auth.adminEmail)
//   - everyone else's access comes from their per-codex permissions/{uid}_{codexId} doc
//   - editor writes codex content; viewer reads only; schemas are admin-only (Types is admin work)
//   - the shared `images` library gates on membership: editors touch their codex + own labels,
//     everything global is admin (see the images block for the full framing)

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in ['bodegigaming@gmail.com', 'aspensquare.chuck@gmail.com'];
    }
    function permId(codexId) {
      return request.auth.uid + '_' + codexId;
    }
    function hasPerm(codexId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/permissions/$(permId(codexId)));
    }
    function isEditor(codexId) {
      return hasPerm(codexId)
        && get(/databases/$(database)/documents/permissions/$(permId(codexId))).data.role == 'editor';
    }
    // A codex you may write content into: admin everywhere, or an editor of that specific codex.
    function canEdit(codexId) {
      return isAdmin() || isEditor(codexId);
    }

    // Global identity roster — own doc (sign-in upsert) or admin.
    match /users/{uid} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // Access grants. Read keyed by id-prefix (NOT resource.data) so a *missing* own-permission doc
    // reads as empty rather than denied — an awaiting-access user must be able to learn they have none.
    // A user may LIST their own grants (query where uid == me) to discover which codices they can open.
    // Writes are admin-only: nobody grants themselves access.
    match /permissions/{doc} {
      allow get:   if isAdmin() || (isSignedIn() && doc.split('_')[0] == request.auth.uid);
      allow list:  if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Codices + their content.
    match /codices/{codexId} {
      allow get:   if isAdmin() || hasPerm(codexId);
      allow list:  if isAdmin();                                  // only an admin enumerates all codices
      allow write: if isAdmin();                                  // codex metadata: admin only

      // Entries carry a monotonic integer `version`. The app writes under a transaction that reads the
      // live version and writes version+1 (a full-doc replace, so field deletions persist); this rule is
      // the data-layer backstop that no write skips or rolls back the version. Conflict *detection* is
      // client-side (only the client knows the base version it started from) — see the write-path spec.
      match /entries/{entryId} {
        function canWriteEntry() { return isAdmin() || isEditor(codexId); }
        allow read:   if isAdmin() || hasPerm(codexId);
        allow create: if canWriteEntry()
          && request.resource.data.version is int
          && request.resource.data.version == 1;
        allow update: if canWriteEntry()
          && request.resource.data.version is int
          && request.resource.data.version == (('version' in resource.data ? resource.data.version : 0) + 1);
        allow delete: if canWriteEntry();
      }
      match /atlas/{docId} {
        allow read:  if isAdmin() || hasPerm(codexId);
        allow write: if isAdmin() || isEditor(codexId);
      }
      match /schemas/{type} {
        allow read:  if isAdmin() || hasPerm(codexId);
        allow write: if isAdmin();                                // Types editing is admin-only
      }
    }

    // Shared image library. Bytes live in Supabase (gated by Storage RLS); this collection is the
    // metadata source of truth for what exists and where it belongs. Framing that keeps the rules
    // enforceable: editors only ever touch codex membership and their own uploads' label —
    // everything global (status, cross-assigning to a codex you can't edit, relabeling others'
    // images) is admin. `id` == content hash == doc id == Supabase object key.
    match /images/{imageId} {
      // Keys changed by this write (added / removed / value-changed). updatedAt is always present.
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // Codices in the new membership but not the old (and vice-versa). List difference, not a loop:
      // membership changes one codex at a time, so exactly one of these is size 1 and the other 0.
      function addedCodices() {
        return request.resource.data.codices.removeAll(resource.data.codices);
      }
      function removedCodices() {
        return resource.data.codices.removeAll(request.resource.data.codices);
      }
      // Editor path (a): add or remove a single codex you can edit, nothing else but the timestamp.
      function editorMembershipChange() {
        return changedKeys().hasOnly(['codices', 'updatedAt'])
          && (
            (addedCodices().size() == 1 && removedCodices().size() == 0 && canEdit(addedCodices()[0]))
            || (removedCodices().size() == 1 && addedCodices().size() == 0 && canEdit(removedCodices()[0]))
          );
      }
      // Editor path (b): rename your own upload. Relabeling someone else's image is admin-only.
      function uploaderRelabel() {
        return changedKeys().hasOnly(['label', 'updatedAt'])
          && resource.data.uploadedBy == request.auth.uid;
      }

      // Metadata isn't secret and the app already gates on sign-in.
      allow read: if isSignedIn();

      // Upload: editor of the single target codex (or admin). Uploader stamps self; new records active.
      allow create: if isSignedIn()
        && request.resource.data.id == imageId
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.codices.size() == 1
        && canEdit(request.resource.data.codices[0]);

      // Admin does anything (status archive/restore, cross-assign, relabel others); editors get the
      // two narrow paths above. Note: an editor re-uploading an *archived* image hits the resurrect
      // (status) write, which is admin-only here — that upload is denied by design.
      allow update: if isAdmin() || editorMembershipChange() || uploaderRelabel();

      // Soft-delete is a status flag, not a document delete. Hard delete is an admin break-glass.
      allow delete: if isAdmin();
    }
  }
}
